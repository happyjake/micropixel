# Waveshare ESP32-S3-RLCD-4.2 board profile (ESP32-S3-WROOM-1-N16R8).
CONFIG_MICROPIXEL_BOARD_WAVESHARE_RLCD_4_2=y

# One 40-row RGB565 strip in SRAM; the ST7305 panel keeps its own 15000-byte
# 1bpp frame in internal DMA RAM.
CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_HEIGHT=40
# CONFIG_MICROPIXEL_LVGL_PARTIAL_BUFFER_PSRAM is not set
